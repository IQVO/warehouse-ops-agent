    "description": "Return one site's Critical Pull Time (CPT) schedule: timezone and the recurring daily cutoffs (cptId, localTime, daysOfWeek, shipMethod, eligiblePathIds). Not found is returned as a tool-level error. Read-only (ADR 0010) — there is no write tool for the schedule.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "siteId": {
          "description": "the site id to look up the CPT schedule for, e.g. sp1",
          "type": "string"
        }
      },
      "required": [
        "siteId"
      ],
      "type": "object"
    },
    "name": "get_cpt_schedule",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "cutoffs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cptId": {
                "type": "string"
              },
              "daysOfWeek": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "eligiblePathIds": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "localTime": {
                "type": "string"
              },
              "shipMethod": {
                "type": "string"
              }
            },
            "required": [
              "cptId",
              "localTime",
              "daysOfWeek",
              "shipMethod",
              "eligiblePathIds"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "siteId": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "siteId",
        "timezone",
        "cutoffs",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    }
  },
