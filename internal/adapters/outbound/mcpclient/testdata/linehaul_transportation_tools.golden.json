    },
    "description": "List departures of the horizon by cutoffAt (then departureId), a page at a time, optionally only those leaving one origin (origin), bound for one destination (destination) and/or whose cutoffAt falls in a window [from, to) (RFC 3339 instants, from inclusive, to exclusive); at most limit rows (1..1000, default 500). Each departure carries its lane, kind (PICKUP, LINEHAUL, AIR), origin and destination nodes, cutoff/departs/arrives, capacity, booked and remaining packages and its state (SCHEDULED, CLOSED, DEPARTED, ARRIVED, CANCELLED). Read-only; a limit outside 1..1000 or a from after to fails with validation-failed, and a from/to that is not an RFC 3339 instant likewise.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "description": "optional: keep only departures bound for this destination node id; omitted means every destination",
          "type": "string"
        },
        "from": {
          "description": "optional: earliest cutoffAt (an RFC 3339 instant such as 2026-10-24T08:00:00Z), inclusive; omitted means unbounded",
          "type": "string"
        },
        "limit": {
          "description": "optional: at most this many departures, 1..1000; omitted or 0 means the default of 500",
          "type": "integer"
        },
        "origin": {
          "description": "optional: keep only departures leaving this origin node id; omitted means every origin",
          "type": "string"
        },
        "to": {
          "description": "optional: latest cutoffAt (an RFC 3339 instant), exclusive; omitted means unbounded",
          "type": "string"
        }
      },
      "type": "object"
    },
